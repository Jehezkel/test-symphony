package main

import "strconv"

templ page(products []product) {
	<!doctype html>
	<html lang="en" data-theme="corporate">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Product catalogue</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<script src="https://unpkg.com/htmx.org@2.0.6"></script>
			<style>
				body { font-family: "DM Sans", sans-serif; }
			</style>
		</head>
		<body class="min-h-screen bg-base-200">
			<main class="mx-auto max-w-5xl p-6 lg:p-10">
				<div class="flex flex-wrap gap-2 mb-5"><a class="btn btn-primary btn-sm" href="/dashboard">Rentowność</a><a class="btn btn-outline btn-sm" href="/integration/allegro">Integracja Allegro</a><a class="btn btn-outline btn-sm" href="/costs">Koszty zakupu</a></div>
				<div class="mb-8">
					<div class="badge badge-primary badge-outline mb-3">GOTH stack</div>
					<h1 class="text-4xl font-bold">Product catalogue</h1>
					<p class="mt-2 text-base-content/70">A tiny in-memory CRUD built with Go, templ, HTMX, and DaisyUI.</p>
				</div>
				<section class="card bg-base-100 shadow-xl">
					<div class="card-body">
						<h2 class="card-title">Add a product</h2>
						<form class="grid gap-3 md:grid-cols-4" hx-post="/products" hx-target="#product-rows" hx-swap="beforeend" hx-on::after-request="if(event.detail.successful) this.reset()">
							<input class="input input-bordered w-full" name="name" placeholder="Name" required/>
							<input class="input input-bordered w-full" name="price" type="number" min="0" step="0.01" placeholder="Price" required/>
							<input class="input input-bordered w-full" name="ean" placeholder="EAN" required/>
							<button class="btn btn-primary" type="submit">Add product</button>
						</form>
						<div class="overflow-x-auto mt-6">
							<table class="table table-zebra">
								<thead><tr><th>Name</th><th>Price</th><th>EAN</th><th class="text-right">Actions</th></tr></thead>
								<tbody id="product-rows">
									for _, item := range products {
										@productRow(item)
									}
								</tbody>
							</table>
						</div>
					</div>
				</section>
			</main>
		</body>
	</html>
}

templ costsPage(items []productCostItem, report *costImportReport) {
	<!doctype html>
	<html lang="pl" data-theme="corporate"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Koszty zakupu produktów</title><link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
	<body class="min-h-screen bg-base-200"><main class="mx-auto max-w-7xl p-6 lg:p-10"><a class="link" href="/">← Katalog</a><h1 class="text-3xl font-bold mt-4">Koszty zakupu produktów</h1><p class="text-base-content/70 mt-2">Kwoty brutto za sztukę. Brak kosztu oznacza niepełny wynik marży.</p>
		if report != nil {
			<div class={ "alert mt-5", templ.KV("alert-error", len(report.Errors) > 0), templ.KV("alert-success", len(report.Errors) == 0) }><div><h2 class="font-bold">Raport importu</h2><p>Dodane: { strconv.Itoa(report.Added) } · Zaktualizowane: { strconv.Itoa(report.Updated) } · Pominięte: { strconv.Itoa(report.Skipped) } · Błędne: { strconv.Itoa(len(report.Errors)) }</p>
			if len(report.Errors) > 0 {
				<p class="font-semibold mt-2">Plik nie został zapisany — popraw wszystkie błędy i zaimportuj go ponownie.</p>
				<ul class="list-disc ml-5 mt-2">
					for _, problem := range report.Errors {
						<li>Wiersz { strconv.Itoa(problem.Row) }: { problem.Message }</li>
					}
				</ul>
			}
			</div></div>
		}
		<section class="card bg-base-100 shadow-xl mt-6"><div class="card-body"><div class="flex flex-wrap justify-between gap-3"><h2 class="card-title">Import CSV</h2><a class="btn btn-outline btn-sm" href="/costs/template.csv">Pobierz szablon</a></div><form class="flex flex-wrap gap-3" method="post" action="/costs/import" enctype="multipart/form-data"><input class="file-input file-input-bordered" type="file" name="file" accept=".csv,text/csv" required/><button class="btn btn-primary" type="submit">Importuj i sprawdź</button></form></div></section>
		<section class="card bg-base-100 shadow-xl mt-6"><div class="card-body"><h2 class="card-title">Produkty, SKU i przypisane oferty</h2><div class="overflow-x-auto"><table class="table table-zebra"><thead><tr><th>Produkt / SKU</th><th>EAN</th><th>Oferty Allegro</th><th>Status</th><th>Koszt brutto</th></tr></thead><tbody>
		for _, item := range items {
			<tr><td><strong>{ item.Name }</strong><br/><span class="font-mono text-xs">{ item.SKU }</span></td><td>{ item.EAN }</td><td class="max-w-md">
				if item.Offers == "" {
					<span class="text-base-content/50">Brak</span>
				} else {
					<span>{ item.Offers }</span>
				}
			</td><td>
				if item.Missing {
					<span class="badge badge-warning">Wymaga uzupełnienia</span>
				} else {
					<span class="badge badge-success">Koszt ustawiony</span>
				}
			</td><td><form class="flex gap-2" method="post" action={ "/costs/" + strconv.FormatInt(item.ID, 10) }><input class="input input-bordered input-sm w-28" name="unit_purchase_cost" inputmode="decimal" value={ item.Cost } placeholder="0.00" required/><select class="select select-bordered select-sm" name="currency"><option selected>PLN</option></select><button class="btn btn-primary btn-sm" type="submit">Zapisz</button></form></td></tr>
		}
		</tbody></table></div></div></section>
	</main></body></html>
}

templ allegroPage(status integrationStatus) {
	<!doctype html>
	<html lang="pl" data-theme="corporate">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Integracja Allegro</title><link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script></head>
		<body class="min-h-screen bg-base-200"><main class="mx-auto max-w-2xl p-6 lg:p-10"><a class="link" href="/">← Katalog</a><section class="card bg-base-100 shadow-xl mt-5"><div class="card-body"><h1 class="card-title text-3xl">Konto Allegro</h1>
			if status.Message != "" {
				<div class="alert alert-info mt-3">{ status.Message }</div>
			}
			if !status.Configured {
				<div class="alert alert-warning mt-4">Integracja nie jest skonfigurowana w tym środowisku.</div>
				<p class="text-base-content/70">Administrator musi ustawić wymagane zmienne środowiskowe.</p>
			} else if status.Connected {
				<div class="badge badge-success badge-lg mt-4">Połączono</div>
				<p>Konto: <strong>{ status.AccountID }</strong></p>
				<p class="text-sm text-base-content/70">Dostęp jest bezpiecznie przechowywany i odnawiany automatycznie.</p>
				<form method="post" action="/integration/allegro/sync"><button class="btn btn-primary" type="submit">Synchronizuj teraz</button></form>
				if status.Sync.Status != "" {
					<div class="divider">Ostatnia synchronizacja</div>
					<p><strong>Stan:</strong> { status.Sync.Status } · <strong>Etap:</strong> { status.Sync.Phase } · <strong>Rekordy:</strong> { strconv.Itoa(status.Sync.Processed) }</p>
					<p class="text-sm text-base-content/70">Start: { status.Sync.StartedAt }</p>
					if status.Sync.FinishedAt != "" {
						<p class="text-sm text-base-content/70">Koniec: { status.Sync.FinishedAt }</p>
					}
					if status.Sync.Error != "" {
						<div class="alert alert-error">{ status.Sync.Error }</div>
					}
				}
				<form method="post" action="/integration/allegro/disconnect"><button class="btn btn-error btn-outline" type="submit">Rozłącz konto</button></form>
			} else {
				<div class="badge badge-ghost badge-lg mt-4">Niepołączono</div>
				<p>Połącz konto, aby aplikacja mogła odczytywać oferty, zamówienia i opłaty.</p>
				<a class="btn btn-primary" href="/oauth/allegro/start">Połącz konto Allegro</a>
			}
		</div></section></main></body>
	</html>
}

templ dashboardPage(data dashboardData, problem string) {
	<!doctype html>
	<html lang="pl" data-theme="corporate">
		<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Rentowność sprzedaży Allegro</title><link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/><script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script><script src="https://unpkg.com/htmx.org@2.0.6"></script></head>
		<body class="min-h-screen bg-base-200"><main class="mx-auto max-w-7xl p-4 sm:p-6 lg:p-10">
			<div class="flex flex-wrap items-center justify-between gap-3"><div><a class="link" href="/">← Katalog</a><h1 class="mt-3 text-3xl font-bold">Rentowność Allegro</h1><p class="mt-1 text-base-content/70">Zysk operacyjny brutto na podstawie zsynchronizowanej sprzedaży i kosztów.</p></div><a class="btn btn-outline btn-sm" href="/costs">Uzupełnij koszty zakupu</a></div>
			<form class="card mt-6 bg-base-100 shadow" hx-get="/dashboard/results" hx-target="#dashboard-results" hx-swap="innerHTML" hx-indicator="#dashboard-loading">
				<div class="card-body gap-4 sm:flex-row sm:items-end"><label class="form-control flex-1"><span class="label-text mb-1">Od</span><input class="input input-bordered w-full" type="date" name="from" value={ data.Range.From } required/></label><label class="form-control flex-1"><span class="label-text mb-1">Do</span><input class="input input-bordered w-full" type="date" name="to" value={ data.Range.To } required/></label><input type="hidden" name="sort" value={ data.Sort }/><button class="btn btn-primary" type="submit">Pokaż wyniki</button><span id="dashboard-loading" class="loading loading-spinner htmx-indicator" aria-label="Ładowanie wyników"></span></div>
			</form>
			<div id="dashboard-results" class="mt-6">
				if problem != "" {
					@dashboardError(problem)
				} else {
					@dashboardResults(data)
				}
			</div>
			<div id="offer-detail" class="mt-6"></div>
		</main></body>
	</html>
}

templ dashboardError(message string) { <div class="alert alert-error" role="alert"><span>{ message }</span></div> }

templ dashboardResults(data dashboardData) {
	if len(data.Offers) == 0 {
		<section class="card bg-base-100 shadow">
			<div class="card-body items-center text-center"><h2 class="card-title">Brak sprzedaży w tym okresie</h2><p class="text-base-content/70">Zmień zakres dat lub zsynchronizuj konto Allegro.</p><a class="btn btn-outline btn-sm" href="/integration/allegro">Przejdź do synchronizacji</a></div>
		</section>
	}
	if len(data.Offers) > 0 {
		if data.KPI.Estimated {
			<div class="alert alert-warning mb-5"><span><strong>Wynik szacunkowy.</strong> Co najmniej jedna sprzedaż ma brakujący koszt lub wymaga weryfikacji.</span></div>
		}
		<section class="grid grid-cols-2 gap-3 lg:grid-cols-6">
			@dashboardStat("Przychód", formatMoney(data.KPI.Revenue,data.KPI.Currency), "")
			@dashboardStat("Koszt produktów", formatMoney(data.KPI.Purchase,data.KPI.Currency), "")
			@dashboardStat("Opłaty Allegro", formatMoney(data.KPI.Allegro,data.KPI.Currency), "")
			@dashboardStat("Pozostałe koszty", formatMoney(data.KPI.Other,data.KPI.Currency), "")
			@dashboardStat("Zysk", formatMoney(data.KPI.Profit,data.KPI.Currency), profitClass(data.KPI.Profit))
			@dashboardStat("Marża", formatMargin(data.KPI.Margin), profitClass(data.KPI.Profit))
		</section>
		<section class="card mt-6 bg-base-100 shadow"><div class="card-body px-3 sm:px-6"><div class="flex flex-wrap items-center justify-between gap-2"><h2 class="card-title">Oferty</h2><span class="text-sm text-base-content/60">Kliknij nagłówek, aby posortować</span></div><div class="overflow-x-auto"><table class="table table-zebra"><thead><tr><th>Oferta</th><th><button class="link" hx-get={ dashboardSortURL("sales",data.Range) } hx-target="#dashboard-results">Sprzedaż</button></th><th><button class="link" hx-get={ dashboardSortURL("revenue",data.Range) } hx-target="#dashboard-results">Przychód</button></th><th><button class="link" hx-get={ dashboardSortURL("profit",data.Range) } hx-target="#dashboard-results">Zysk ↑</button></th><th><button class="link" hx-get={ dashboardSortURL("margin",data.Range) } hx-target="#dashboard-results">Marża ↑</button></th><th></th></tr></thead><tbody>
			for _, item := range data.Offers {
				<tr class={ templ.KV("bg-error/10",item.Profit<0) }><td class="min-w-56"><strong>{ item.Name }</strong><br/><span class="text-xs text-base-content/60">{ item.AllegroID }
					if item.SKU!="" {
						<span> · { item.SKU }</span>
					}
				</span><div class="mt-1 flex flex-wrap gap-1">
					if item.Profit<0 {
						<span class="badge badge-error badge-sm">Nierentowna</span>
					}
					if item.MissingCost {
						<span class="badge badge-warning badge-sm">Brak kosztu zakupu</span>
					} else if item.Estimated {
						<span class="badge badge-warning badge-sm">Szacunkowa</span>
					}
				</div></td><td>{ strconv.FormatInt(item.Sales,10) }</td><td>{ formatMoney(item.Revenue,item.Currency) }</td><td class={ templ.KV("font-bold text-error",item.Profit<0),templ.KV("font-bold text-success",item.Profit>=0) }>{ formatMoney(item.Profit,item.Currency) }</td><td>{ formatMargin(item.Margin) }</td><td><button class="btn btn-ghost btn-sm" hx-get={ offerDetailURL(item.ID,data.Range) } hx-target="#offer-detail" hx-swap="innerHTML" hx-indicator="#dashboard-loading">Szczegóły</button></td></tr>
			}
			</tbody></table></div></div></section>
	}
}

templ dashboardStat(label,value string, className string) { <div class="stat rounded-box bg-base-100 p-4 shadow"><div class="stat-title text-xs sm:text-sm">{ label }</div><div class={ "stat-value text-lg sm:text-xl", className }>{ value }</div></div> }

templ dashboardOfferDetail(item dashboardOfferItem, rng dashboardRange) {
	<section class="card bg-base-100 shadow-xl"><div class="card-body px-3 sm:px-6"><div class="flex justify-between gap-3"><div><h2 class="card-title">{ item.Name }</h2><p class="text-sm text-base-content/60">Oferta { item.AllegroID } · { rng.From }–{ rng.To }</p></div><button class="btn btn-circle btn-ghost btn-sm" onclick="document.getElementById('offer-detail').innerHTML=''" aria-label="Zamknij">✕</button></div>
		<div class="grid grid-cols-2 gap-2 md:grid-cols-5">@dashboardStat("Przychód",formatMoney(item.Revenue,item.Currency),"") @dashboardStat("Koszt produktów",formatMoney(item.Purchase,item.Currency),"") @dashboardStat("Opłaty Allegro",formatMoney(item.Allegro,item.Currency),"") @dashboardStat("Inne koszty",formatMoney(item.Other,item.Currency),"") @dashboardStat("Zysk",formatMoney(item.Profit,item.Currency),profitClass(item.Profit))</div>
		<div class="overflow-x-auto"><table class="table"><thead><tr><th>Sprzedaż</th><th>Szt.</th><th>Przychód</th><th>Produkt</th><th>Allegro</th><th>Inne</th><th>Zysk</th><th>Status</th></tr></thead><tbody>
			for _, line := range item.Lines {
				<tr><td>{ shortDate(line.BoughtAt) }<br/><span class="font-mono text-xs">{ line.AllegroOrderID }</span></td><td>{ strconv.FormatInt(line.Quantity,10) }</td><td>{ formatMoney(line.Revenue,item.Currency) }</td><td>{ formatMoney(line.Purchase,item.Currency) }</td><td>{ formatMoney(line.Allegro,item.Currency) }</td><td>{ formatMoney(line.Other,item.Currency) }</td><td class={ templ.KV("text-error font-bold",line.Profit<0) }>{ formatMoney(line.Profit,item.Currency) }</td><td>
					if line.Completeness!="complete" {
						<span class="badge badge-warning badge-sm">Niepełne koszty</span>
					} else if line.Estimated {
						<span class="badge badge-warning badge-sm">Szacunek</span>
					} else {
						<span class="badge badge-success badge-sm">Kompletne</span>
					}
				</td></tr>
			}
		</tbody></table></div>
	</div></section>
}

templ productRow(item product) {
	<tr id={ "product-" + strconv.FormatInt(item.ID, 10) }>
		<td class="font-medium">{ item.Name }</td><td>{ item.Price }</td><td>{ item.EAN }</td>
		<td class="text-right space-x-2">
			<button class="btn btn-sm btn-ghost" hx-get={ "/products/" + strconv.FormatInt(item.ID, 10) + "/edit" } hx-target={ "#product-" + strconv.FormatInt(item.ID, 10) } hx-swap="outerHTML">Edit</button>
			<button class="btn btn-sm btn-error btn-outline" hx-delete={ "/products/" + strconv.FormatInt(item.ID, 10) } hx-target={ "#product-" + strconv.FormatInt(item.ID, 10) } hx-swap="outerHTML" hx-confirm="Delete this product?">Delete</button>
		</td>
	</tr>
}

templ productEditRow(item product) {
	<tr id={ "product-" + strconv.FormatInt(item.ID, 10) }>
		<td colspan="4">
			<form class="grid gap-2 md:grid-cols-4" hx-put={ "/products/" + strconv.FormatInt(item.ID, 10) } hx-target={ "#product-" + strconv.FormatInt(item.ID, 10) } hx-swap="outerHTML">
				<input class="input input-sm input-bordered" name="name" value={ item.Name } required/>
				<input class="input input-sm input-bordered" name="price" type="number" min="0" step="0.01" value={ item.Price } required/>
				<input class="input input-sm input-bordered" name="ean" value={ item.EAN } required/>
				<button class="btn btn-sm btn-success" type="submit">Save</button>
			</form>
		</td>
	</tr>
}
