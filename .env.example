# Authentication (required)
AUTH_EMAIL=
AUTH_PASSWORD=
# Optional display name and session configuration.
# AUTH_DISPLAY_NAME=
# SESSION_TTL_HOURS=24
# Set to production to add Secure to the session cookie.
# APP_ENV=development
# Public origin used to build one-time links.
# APP_BASE_URL=http://localhost:8080

# Email delivery. Development defaults to a discard adapter that never logs tokens.
# Production requires EMAIL_PROVIDER=smtp.
# EMAIL_PROVIDER=discard
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Allegro environment: production or sandbox. The safe default is sandbox.
ALLEGRO_ENVIRONMENT=sandbox
# Credentials and redirect URIs are kept separate for each environment.
ALLEGRO_SANDBOX_CLIENT_ID=
ALLEGRO_SANDBOX_CLIENT_SECRET=
ALLEGRO_SANDBOX_REDIRECT_URL=http://localhost:8080/oauth/allegro/callback
ALLEGRO_PRODUCTION_CLIENT_ID=
ALLEGRO_PRODUCTION_CLIENT_SECRET=
ALLEGRO_PRODUCTION_REDIRECT_URL=
# Base64-encoded random 32-byte key. Never commit its real value.
ALLEGRO_TOKEN_ENCRYPTION_KEY=

# Periodic synchronization interval in minutes; 0 disables it (default: 15).
# ALLEGRO_SYNC_INTERVAL_MINUTES=15
