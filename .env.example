# Allegro OAuth (required together to enable the integration)
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URL=http://localhost:8080/oauth/allegro/callback
# Base64-encoded random 32-byte key. Never commit its real value.
ALLEGRO_TOKEN_ENCRYPTION_KEY=

# Optional Allegro sandbox/custom endpoints
# ALLEGRO_AUTHORIZE_URL=https://allegro.pl/auth/oauth/authorize
# ALLEGRO_TOKEN_URL=https://allegro.pl/auth/oauth/token
# ALLEGRO_API_URL=https://api.allegro.pl
# Periodic synchronization interval in minutes; 0 disables it (default: 15).
# ALLEGRO_SYNC_INTERVAL_MINUTES=15
